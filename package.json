{
	"name": "@alexh-r/calendly-sdk",
	"version": "0.1.3",
	"description": "Unofficial typed TypeScript SDK for the Calendly API",
	"author": "Alejandro Hernández Rosa",
	"license": "MIT",
	"keywords": [
		"calendly",
		"sdk",
		"api",
		"typescript"
	],
	"engines": {
		"node": ">=20"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AlexH-R/calendly-sdk.git"
	},
	"homepage": "https://github.com/AlexH-R/calendly-sdk#readme",
	"bugs": {
		"url": "https://github.com/AlexH-R/calendly-sdk/issues"
	},
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"test": "bun test",
		"lint": "biome check src",
		"lint:fix": "biome check src --write",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run lint && bun run typecheck && bun test && bun run build"
	},
	"devDependencies": {
		"@types/bun": "1.4.5",
		"typescript": "7.0.2",
		"@biomejs/biome": "2.6.8"
	}
}
